{
  "name": "sat-quest",
  "version": "1.0.0",
  "description": "🧠 SAT Quest — Gamified SAT prep that feels like a game",
  "scripts": {
    "dev": "pnpm exec convex dev",
    "start": "pnpm dlx serve .",
    "lint": "eslint src/",
    "build": "sh scripts/build-pages.sh",
    "deploy": "pnpm run build && pnpm dlx wrangler pages deploy dist --project-name sats-quest --branch main"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonio59/sats-quest.git"
  },
  "dependencies": {
    "convex": "^1.45.0"
  },
  "packageManager": "pnpm@11.1.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
